# Copier ce fichier en .env puis adapter les valeurs.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://craftflow:craftflow@localhost:5432/craftflow
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
